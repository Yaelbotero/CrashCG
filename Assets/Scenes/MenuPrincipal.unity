  textoDialogo: {fileID: 709310260}
  imagenDialogo: {fileID: 990571562}
  fundido: {fileID: 2116814819}
  lineas:
  - texto: "\xA1Vaya, vaya... Crash Bandicoot! Sab\xEDa que vendr\xEDas."
    voz: {fileID: 8300000, guid: 4c10d2f318fe3c94595b957ad0076074, type: 3}
    imagen: {fileID: 21300000, guid: 042d0b9b6b591c940b3d1b7d3cf9033d, type: 3}
  - texto: Tengo unas pruebas que quiero que superes, Crash.
    voz: {fileID: 8300000, guid: efbd667cef3d4ca409319aaeff282e30, type: 3}
    imagen: {fileID: 21300000, guid: 9e8de64e54b193044ba35ebbd5e51ef0, type: 3}
  - texto: Cruza mis portales del tiempo... si es que te atreves.
    voz: {fileID: 8300000, guid: be571590080e6ce499a978677805672b, type: 3}
    imagen: {fileID: 21300000, guid: c3e5e258c20077f4089153b68c9851cd, type: 3}
  - texto: "\xA1Y esta vez nadie podr\xE1 detenerme! \xA1Ja, ja, ja, ja!"
    voz: {fileID: 8300000, guid: a0a03809c86fa5c48884cdee076f72e8, type: 3}
    imagen: {fileID: 21300000, guid: 078000f1691da254e8de6f1b7cff4ed5, type: 3}
  panelMenu: {fileID: 1208909671}
  textoSaltar: {fileID: 1573011178}
  puntosHablar:
  - {x: 0.9, y: 0.75, z: 0}
  - {x: -0.9, y: 0.85, z: 0.4}
  - {x: 0.3, y: 0.7, z: -0.5}
  - {x: -0.6, y: 0.8, z: 0.2}
  escenaSiguiente: SelectorNiveles
  escenaRespaldo: Gee Wiz
