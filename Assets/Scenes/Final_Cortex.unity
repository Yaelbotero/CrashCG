  lineas:
  - texto: "\xA1No... no puede ser! \xA1Derrotado otra vez por un bandicoot!"
    voz: {fileID: 8300000, guid: 0dcf2b2c5e5993b4ca5d5c6df812e9ea, type: 3}
    imagen: {fileID: 21300000, guid: fd0a837c2913c9c45b0361d9678ec77d, type: 3}
  - texto: "Esto no se ha terminado, Crash... \xA1Volver\xE9, y la pr\xF3xima vez
